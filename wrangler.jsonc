{
  // Singhania's: static site (Workers Assets) + API (Worker) + D1 database.
  "name": "singhanias",
  "main": "worker/src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    // No database_id on purpose: Cloudflare creates this database on the first deploy.
    // The Worker creates its own tables and loads the starting catalogue on first request.
    { "binding": "DB", "database_name": "singhanias-db" }
  ],
  "vars": { "WHATSAPP_NUMBER": "919320685055" }
  // Secret (never commit):  npx wrangler secret put ADMIN_TOKEN
}
