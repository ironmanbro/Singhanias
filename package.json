{
  "name": "singhanias",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build:css": "tailwindcss -c tailwind.config.js -i input.css -o styles.css --minify",
    "db:migrate:local": "wrangler d1 execute singhanias-db --local --file=worker/schema.sql",
    "db:seed:local": "node worker/seed.mjs --test-stock > worker/seed.generated.sql && wrangler d1 execute singhanias-db --local --file=worker/seed.generated.sql",
    "test": "node --test tests/api.test.mjs",
    "test:ui": "node tests/ui.test.mjs"
  },
  "devDependencies": {
    "miniflare": "^4.20260730.0",
    "tailwindcss": "3.4.17",
    "wrangler": "^4.0.0"
  }
}
